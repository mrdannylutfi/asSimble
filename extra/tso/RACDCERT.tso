/* STEP 1: CREATE THE RACF VIRTUAL KEYRING FOR THE STARTED TASK */
RACDCERT ADDRING(SECURE.CRYPTO.KEYRING) ID(CSSMTPID)

/* STEP 2: GENERATE A SELF-SIGNED LOCAL CA CERTIFICATE FOR TESTING */
RACDCERT GENCERT CERTAUTH +
  SUBJECTSDN(CN('z16 Secure Root CA') O('Your Company') C('US')) +
  WITHLABEL('z16SecureRootCA') +
  NOTAFTER(DATE(2035/12/31))

/* STEP 3: GENERATE THE CSSMTP CLIENT ENCRYPTION CERTIFICATE */
RACDCERT GENCERT ID(CSSMTPID) +
  SUBJECTSDN(CN('://yourcompany.com') O('Your Company') C('US')) +
  WITHLABEL('CSSMTP_Client_Cert') +
  SIGNWITH(CERTAUTH LABEL('z16SecureRootCA')) +
  NOTAFTER(DATE(2028/12/31))

/* STEP 4: CONNECT BOTH CERTIFICATES TO THE KEYRING */
RACDCERT CONNECT(CERTAUTH LABEL('z16SecureRootCA') +
  RING(SECURE.CRYPTO.KEYRING) USAGE(CERTAUTH)) ID(CSSMTPID)

RACDCERT CONNECT(ID(CSSMTPID) LABEL('CSSMTP_Client_Cert') +
  RING(SECURE.CRYPTO.KEYRING) USAGE(PERSONAL) DEFAULT) ID(CSSMTPID)

/* STEP 5: REFRESH IN-STORAGE DIGTCERT STRUCTURES */
SETROPTS RACLIST(DIGTCERT, DIGTRING) REFRESH

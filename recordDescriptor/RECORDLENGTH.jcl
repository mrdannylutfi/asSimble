//RUNBCH   JOB (ACCT),'RUN LARGE COBOL',CLASS=A,MSGCLASS=X
//RUNSTEP  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=YOUR.PRODUCTION.LOADLIB,DISP=SHR
//         DD DSN=DSN120.SDSNLOAD,DISP=SHR
//** INPUT FILE WITH EXTENDED LENGTH CONSTRAINTS
//EMPIN    DD DSN=YOUR.INPUT.DATASET,DISP=SHR,
//            DCB=(RECFM=FB,LRECL=2000000)
//** OUTPUT ERROR TRACKING LOG REPORT FILE
//ERRFILE  DD DSN=YOUR.OUTPUT.ERROR.LOG,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(50,50),RLSE),
//            DCB=(RECFM=FB,LRECL=2000000)
//SYSOUT   DD SYSOUT=*
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(DB2A)
  RUN PROGRAM(CBLO2DB2) PLAN(CBLO2PLN)
  END
